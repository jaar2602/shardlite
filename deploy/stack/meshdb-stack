#!/usr/bin/env bash
#
# meshdb-stack — one CLI to deploy the whole meshdb app with Docker: a 3-node HA cluster plus the
# web console, all state kept on Docker volumes so it survives restarts.
#
#   ./meshdb-stack up          build images (first run) and start everything, then print how to sign in
#   ./meshdb-stack down        stop the stack, KEEP all data (volumes)
#   ./meshdb-stack restart     restart the running services
#   ./meshdb-stack status      show container + health status
#   ./meshdb-stack logs [svc]  follow logs (all services, or one: node1|node2|node3|console)
#   ./meshdb-stack register    (re)register the cluster as a console connection
#   ./meshdb-stack destroy     stop AND delete all volumes + secrets (irreversible)
#
# Requires: docker with the compose plugin (or docker-compose), curl. No manual setup — the first
# `up` generates the console master key and admin password into ./.env and reuses them thereafter.
set -euo pipefail
cd "$(dirname "$0")"

# --- config (override via environment) -------------------------------------------------------
CONSOLE_PORT="${CONSOLE_PORT:-7100}"
CONSOLE_URL="http://localhost:${CONSOLE_PORT}"
CONN_NAME="${CONN_NAME:-meshdb}"
# The addresses the console (inside the Docker network) uses to reach the nodes — service names on
# the internal gateway port, NOT the host-mapped 8081-8083.
SEEDS='["http://node1:8080","http://node2:8080","http://node3:8080"]'
ENV_FILE=".env"

# --- prerequisites -------------------------------------------------------------------------------
if ! command -v docker >/dev/null 2>&1; then
  echo "error: docker is not installed or not on PATH." >&2; exit 1
fi
if docker compose version >/dev/null 2>&1; then
  DC=(docker compose)
elif command -v docker-compose >/dev/null 2>&1; then
  DC=(docker-compose)
else
  echo "error: need the docker compose plugin (or docker-compose)." >&2; exit 1
fi

gen_secret() {
  # 48 hex chars of randomness, without assuming openssl is present.
  openssl rand -hex 24 2>/dev/null || head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n'
}

ensure_env() {
  if [ -f "$ENV_FILE" ]; then return; fi
  echo "==> first run: generating $ENV_FILE (console master key + admin password)"
  umask 077
  cat > "$ENV_FILE" <<EOF
# Generated by meshdb-stack. Keep this file — MESHDB_CONSOLE_KEY encrypts the console's stored
# secrets at rest; if it changes, existing connections and the saved AI key can no longer be
# decrypted. These are your admin credentials for $CONSOLE_URL.
MESHDB_CONSOLE_KEY=$(gen_secret)
MESHDB_CONSOLE_ADMIN=admin
MESHDB_CONSOLE_ADMIN_PASSWORD=$(gen_secret)
EOF
  chmod 600 "$ENV_FILE"
}

load_env() {
  # Expose the admin credentials to this script (for connection registration). Compose reads
  # .env on its own for the container environment.
  set -a; # shellcheck disable=SC1090
  . "./$ENV_FILE"; set +a
}

wait_for_console() {
  echo -n "==> waiting for the console to be healthy"
  for _ in $(seq 1 60); do
    if curl -fsS "${CONSOLE_URL}/healthz" >/dev/null 2>&1; then echo " — ok"; return 0; fi
    echo -n "."; sleep 1
  done
  echo; echo "warning: console did not report healthy in time; check '$0 logs console'." >&2
  return 1
}

register_connection() {
  load_env
  local jar; jar="$(mktemp)"
  trap 'rm -f "$jar"' RETURN

  local login
  login="$(curl -fsS -c "$jar" -X POST "${CONSOLE_URL}/api/login" \
    -H 'content-type: application/json' \
    -d "{\"username\":\"${MESHDB_CONSOLE_ADMIN}\",\"password\":\"${MESHDB_CONSOLE_ADMIN_PASSWORD}\"}" 2>/dev/null)" || {
    echo "warning: could not log in to register the connection; add it in the UI." >&2; return 1; }
  local csrf
  csrf="$(printf '%s' "$login" | sed -n 's/.*"csrf_token":"\([^"]*\)".*/\1/p')"
  if [ -z "$csrf" ]; then
    echo "warning: login returned no CSRF token; add the connection in the UI." >&2; return 1
  fi

  # Idempotent: skip if a connection with this name already exists.
  if curl -fsS -b "$jar" "${CONSOLE_URL}/api/connections" 2>/dev/null | grep -q "\"name\":\"${CONN_NAME}\""; then
    echo "==> connection '${CONN_NAME}' already registered"
    return 0
  fi

  echo "==> registering the cluster as connection '${CONN_NAME}'"
  curl -fsS -b "$jar" -X POST "${CONSOLE_URL}/api/connections" \
    -H 'content-type: application/json' -H "X-CSRF-Token: ${csrf}" \
    -d "{\"name\":\"${CONN_NAME}\",\"seeds\":${SEEDS},\"allow_insecure_http\":true}" >/dev/null 2>&1 \
    && echo "   -> done" \
    || echo "   warning: registration failed; add it in the UI (seeds: node1/2/3:8080)." >&2
}

summary() {
  load_env
  cat <<EOF

============================================================
 meshdb is up.

   console:   ${CONSOLE_URL}
     user     ${MESHDB_CONSOLE_ADMIN}
     password ${MESHDB_CONSOLE_ADMIN_PASSWORD}   (also in ./.env)

   cluster nodes on the host:
     http://localhost:8081  http://localhost:8082  http://localhost:8083

   connection "${CONN_NAME}" is registered and points the console at the 3 nodes.

 Data persists on Docker volumes. Stop with:   $0 down   (keeps data)
 Wipe everything (volumes + secrets) with:     $0 destroy
============================================================
EOF
}

cmd_up() {
  ensure_env
  echo "==> building images and starting the stack (this can take a few minutes on first run)"
  "${DC[@]}" up -d --build
  wait_for_console || true
  register_connection || true
  summary
}

cmd_down()    { "${DC[@]}" down; echo "==> stopped. Data kept on volumes — '$0 up' resumes it."; }
cmd_restart() { "${DC[@]}" restart; echo "==> restarted."; }
cmd_status()  { "${DC[@]}" ps; }
cmd_logs()    { "${DC[@]}" logs -f "${1:-}"; }

cmd_destroy() {
  echo "This deletes the cluster data, the console's users/connections/AI settings, AND ./.env."
  read -r -p "Type 'destroy' to confirm: " reply
  if [ "$reply" != "destroy" ]; then echo "aborted."; exit 1; fi
  "${DC[@]}" down -v
  rm -f "$ENV_FILE"
  echo "==> destroyed: volumes and secrets removed."
}

usage() { awk 'NR>=3 && /^#/ {sub(/^# ?/,""); print; next} NR>=3 {exit}' "$0"; }

case "${1:-}" in
  up)        cmd_up ;;
  down)      cmd_down ;;
  restart)   cmd_restart ;;
  status|ps) cmd_status ;;
  logs)      shift; cmd_logs "${1:-}" ;;
  register)  wait_for_console || true; register_connection ;;
  destroy)   cmd_destroy ;;
  ""|-h|--help|help) usage ;;
  *) echo "unknown command: $1" >&2; usage; exit 1 ;;
esac
